{
  "id": "/Mamali/",
  "name": "ماملی — منظومه اجتماعی سه‌بعدی",
  "short_name": "ماملی",
  "description": "لانچر اجتماعی سه‌بعدی قابل نصب روی Android و Windows با بروزرسانی زنده، اجرای مستقل و پشتیبانی آفلاین.",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/Mamali/",
  "scope": "/Mamali/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050712",
  "theme_color": "#080b18",
  "categories": ["social", "entertainment", "utilities", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/android-install-wide.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "نصب و بروزرسانی ماملی روی Android و Windows"
    },
    {
      "src": "assets/screenshots/windows-install-wide.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "نصب برنامه Mamali روی Windows 10 و 11"
    },
    {
      "src": "assets/screenshots/android-install-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "نسخه موبایل ماملی با Update Center زنده"
    }
  ],
  "shortcuts": [
    {
      "name": "بازکردن پورتال‌ها",
      "short_name": "پورتال‌ها",
      "description": "اجرای مستقیم اپ‌های اجتماعی",
      "url": "/Mamali/#portals",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "نصب روی Android و Windows",
      "short_name": "نصب اپ",
      "description": "راهنمای نصب برنامه روی گوشی و ویندوز",
      "url": "/Mamali/#android-app",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "بررسی بروزرسانی",
      "short_name": "بروزرسانی",
      "description": "اتصال به کانال پایدار و دریافت آخرین نسخه",
      "url": "/Mamali/#updateCenter",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
