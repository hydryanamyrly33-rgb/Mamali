{
  "id": "/Mamali/",
  "name": "ماملی — منظومه اجتماعی سه‌بعدی",
  "short_name": "ماملی",
  "description": "لانچر اجتماعی سه‌بعدی هوشمند برای Android (عمودی)، Windows (افقی) و iOS با ورود گوگل گرد، تشخیص دستگاه و تست زنده.",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/Mamali/",
  "scope": "/Mamali/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#050712",
  "theme_color": "#080b18",
  "categories": ["social", "entertainment", "utilities", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 400 },
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "assets/screenshots/android-install-wide.png", "sizes": "1440x1000", "type": "image/png", "form_factor": "wide", "label": "ماملی 3.4 اندروید عمودی با ریپل لمسی" },
    { "src": "assets/screenshots/windows-install-wide.png", "sizes": "1440x1000", "type": "image/png", "form_factor": "wide", "label": "ماملی 3.4 ویندوز افقی با نور موس" },
    { "src": "assets/screenshots/android-install-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "iOS و Android عمودی" }
  ],
  "shortcuts": [
    { "name": "بازکردن پورتال‌ها", "short_name": "پورتال‌ها", "description": "اجرای مستقیم اپ‌های اجتماعی", "url": "/Mamali/#portals", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "نصب روی Android و Windows", "short_name": "نصب اپ", "description": "راهنمای نصب برنامه روی گوشی و ویندوز و iOS", "url": "/Mamali/#android-app", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "بررسی بروزرسانی", "short_name": "بروزرسانی", "description": "اتصال به کانال پایدار و دریافت آخرین نسخه", "url": "/Mamali/#updateCenter", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
